<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/source_metadata_check_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/source_metadata_check_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="8dp" />

            <ImageButton
                android:id="@+id/dismiss_source_metadata_check"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/button_close"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="?attr/colorControlNormal" />
        </LinearLayout>

        <TextView
            android:id="@+id/source_selection_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="@string/filter_category_update_failed"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/filter_set_apply_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/filter_set_apply_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filter_set_apply_retry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lists_state_retry"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hosts_sources_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:contentDescription="@string/hosts_title"
            android:longClickable="true"
            android:paddingBottom="@dimen/fab_list_bottom_clearance"
            android:paddingEnd="@dimen/fab_list_side_clearance"
            android:scrollbars="vertical"
            tools:layoutManager="androidx.appcompat.widget.LinearLayoutManager"
            tools:listitem="@layout/filter_source_item" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/hosts_sources_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/hosts_add_dialog_title"
        app:srcCompat="@drawable/ic_add_black_24px" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
